{
  "name": "forevercars",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "pnpm --filter site dev",
    "dev:desktop": "pnpm --filter desktop dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.7.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,json,md,css}": [
      "prettier --write"
    ]
  }
}
